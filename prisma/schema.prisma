
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String    @db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model ConsultationBooking {
  id               String    @id @default(cuid())
  name             String    @db.VarChar(191)
  contact          String    @db.VarChar(191)
  type             String    @db.VarChar(191)
  subcategory      String?   @db.VarChar(191)
  otherSubcategory String?   @db.VarChar(191)
  format           String    @default("In-person") @db.VarChar(50)
  notes            String?   @db.Text
  status           String    @default("pending") @db.VarChar(50)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("consultation_booking")
}

model Category {
  name          String   @id @db.VarChar(191)
  variantLabels Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("product_category")
}

model Product {
  id              String            @id @db.VarChar(191)
  name            String            @db.VarChar(191)
  category        String            @db.VarChar(191)
  type            String            @default("physical") @db.VarChar(32)
  description     String            @db.Text
  price           Decimal           @db.Decimal(12, 2)
  availability    String            @db.VarChar(191) @default("In Stock")
  stock           Int               @default(0)
  featured        Boolean           @default(false)
  image           String            @db.VarChar(500)
  gallery         Json?
  alt             String            @db.Text
  longDescription String?           @db.Text
  highlights      Json?
  nutritionNote   String?           @db.Text
  nutrition       Json?
  benefits        Json?
  usage           Json?
  caution         String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  variants        ProductVariant[]
  saleItems       SaleItem[]
  movements       StockMovement[]

  @@index([category])
  @@index([createdAt])
  @@map("product")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String   @db.VarChar(191)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String   @db.VarChar(191)
  price     Decimal  @db.Decimal(12, 2)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, label])
  @@index([productId])
  @@map("product_variant")
}

model Sale {
  id              String    @id @default(cuid())
  customerName    String    @db.VarChar(191)
  customerContact String?   @db.VarChar(191)
  customerEmail   String?   @db.VarChar(191)
  paymentStatus   String    @default("paid") @db.VarChar(32)
  subtotal        Decimal   @db.Decimal(12, 2)
  taxRate         Decimal   @default(0) @db.Decimal(5, 2)
  tax             Decimal   @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  items           SaleItem[]
  invoice         Invoice?
  payments        Payment[]

  @@index([createdAt])
  @@index([paymentStatus])
  @@map("sale")
}

model SaleItem {
  id           String    @id @default(cuid())
  saleId       String
  sale         Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String?   @db.VarChar(191)
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  name         String    @db.VarChar(191)
  variantLabel String?   @db.VarChar(191)
  unitPrice    Decimal   @db.Decimal(12, 2)
  quantity     Int
  total        Decimal   @db.Decimal(12, 2)

  @@index([saleId])
  @@map("sale_item")
}

model Invoice {
  id          String          @id @default(cuid())
  number      Int             @unique @default(autoincrement())
  saleId      String          @unique
  sale        Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  status      String          @default("pending") @db.VarChar(32)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  movements   StockMovement[]

  @@index([status])
  @@index([createdAt])
  @@map("invoice")
}

model Payment {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([createdAt])
  @@map("payment")
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String   @db.VarChar(191)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String   @db.VarChar(32)
  note      String?  @db.Text
  invoiceId String?   @db.VarChar(191)
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("stock_movement")
}

model BlogPost {
  slug      String   @id @db.VarChar(191)
  title     String   @db.VarChar(255)
  excerpt   String   @db.Text
  category  String   @db.VarChar(191)
  date      String   @db.VarChar(64)
  readTime  String   @db.VarChar(64)
  image     String   @db.VarChar(500)
  gallery   Json?
  alt       String   @db.Text
  featured  Boolean  @default(false)
  sections  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
  @@map("blog_post")
}

model Image {
  id        String   @id @default(cuid())
  filename  String   @db.VarChar(255)
  mimeType  String   @db.VarChar(64)
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("image")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String   @db.VarChar(64)
  entity    String   @db.VarChar(64)
  entityId  String?  @db.VarChar(191)
  message   String   @db.Text
  userEmail String?  @db.VarChar(191)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, createdAt])
  @@map("activity_log")
}
